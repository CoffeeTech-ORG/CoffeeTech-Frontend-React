# Backend API URL
VITE_BACKEND_SERVICE_URL=localhost:5000/api/v1

# OpenWeatherMap API Key
VITE_OPENWEATHER_API_KEY="your_openweathermap_api_key_here"

# Maps and place search.
#   - Street map: OpenStreetMap, keyless
#   - Satellite up to z=18: Esri World Imagery, keyless and unmetered
#   - Search and reverse geocoding: Photon (photon.komoot.io), keyless
#
#   - Labels over the satellite: Esri (roads) and CARTO (place names), keyless
#
# NO map service needs a key. MapTiler's satellite imagery has less detail than Esri's at the
# same pixel count (see the note in components/MapView/tileProviders.ts).

# Model service (FastAPI). Publishes the agronomic reference ranges the Reports chart draws.
# If absent, the chart is drawn without bands.
VITE_MODEL_SERVICE_URL=http://localhost:8000
